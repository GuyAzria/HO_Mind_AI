<!-- // [MODIFIED v1.57.0 | 2026-08-02] Purpose: Updated project RootNamespace, ApplicationTitle, and ApplicationId to match the new HO-Mind AI branding. -->
<!-- // [MODIFIED v1.56.0 | 2026-04-07] Purpose: Updated TargetPlatformVersion to 36.0 to align with the .NET 10 preview SDK's strictly supported Android 16 APIs, resolving the invalid platform version compilation error. -->
<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Only targeting mobile platforms now! -->
		<TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>HO_Mind_AI</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<ApplicationTitle>HO-Mind-AI</ApplicationTitle>
		<ApplicationId>com.guyazria.homindai</ApplicationId>
		<ApplicationVersion>4</ApplicationVersion>
		<ApplicationDisplayVersion>2026.10.22</ApplicationDisplayVersion>

		<!-- OS Targeting -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">11.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">13.1</SupportedOSPlatformVersion>

		<!-- ANDROID SPECIFIC FIXES -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<TargetPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">36.0</TargetPlatformVersion>

		<!-- Silence Harmless Version Mismatch Warnings -->
		<NoWarn>$(NoWarn);NU1608</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#0288d1" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0A192F" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\*" />
	</ItemGroup>

	<ItemGroup>
	  <None Remove="Platforms\Android\Resources\automotive_app_desc.xml" />
	  <None Remove="Platforms\Android\Resources\layout\floating_assistant.xml" />
	  <None Remove="Platforms\Android\Resources\values\styles.xml" />
	</ItemGroup>

	<!-- MAUI CORE CONTROLS -->
	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="14.1.0" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.51" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.51" />
		<PackageReference Include="OpenCvSharp4" Version="4.13.0.20260330" />
		<PackageReference Include="Plugin.BLE" Version="3.2.0" />
	</ItemGroup>

	<!-- NATIVE CAMERAX & ML KIT -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<PackageReference Include="Xamarin.AndroidX.Camera.Camera2" Version="1.5.3.1" />
		<PackageReference Include="Xamarin.AndroidX.Camera.Lifecycle" Version="1.5.3.1" />
		<PackageReference Include="Xamarin.AndroidX.Camera.View" Version="1.5.3.1" />
		<PackageReference Include="Xamarin.Google.MLKit.BarcodeScanning" Version="117.3.0.7" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
	  <PackageReference Include="Xamarin.AndroidX.Car.App.App">
	    <Version>1.7.0.3</Version>
	  </PackageReference>
	</ItemGroup>

</Project>