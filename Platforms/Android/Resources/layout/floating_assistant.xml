<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_overlay"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/floating_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp"
        android:background="#CC000000">

        <TextView
            android:id="@+id/stt_text_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Listening..."
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="3"
            android:ellipsize="end"
            android:layout_marginBottom="30dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/open_app_button"
                android:layout_width="140dp"
                android:layout_height="50dp"
                android:text="Open Chat"
                android:backgroundTint="#44FFFFFF"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="10dp" />

            <Button
                android:id="@+id/transcribe_button"
                android:layout_width="140dp"
                android:layout_height="50dp"
                android:text="Transcribe"
                android:backgroundTint="#44FFFFFF"
                android:textColor="#FFFFFF" />

        </LinearLayout>

        <Button
            android:id="@+id/bt_toggle_button"
            android:layout_width="140dp"
            android:layout_height="50dp"
            android:text="🎧 BT: OFF"
            android:backgroundTint="#44FFFFFF"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="25dp" />

        <LinearLayout
            android:id="@+id/wave_container"
            android:layout_width="wrap_content"
            android:layout_height="80dp"
            android:orientation="horizontal"
            android:gravity="bottom|center_horizontal">

            <View android:id="@+id/wave1" android:layout_width="12dp" android:layout_height="15dp" android:layout_marginEnd="10dp" />
            <View android:id="@+id/wave2" android:layout_width="12dp" android:layout_height="15dp" android:layout_marginEnd="10dp" />
            <View android:id="@+id/wave3" android:layout_width="12dp" android:layout_height="15dp" android:layout_marginEnd="10dp" />
            <View android:id="@+id/wave4" android:layout_width="12dp" android:layout_height="15dp" />

        </LinearLayout>

        <Button
            android:id="@+id/close_overlay_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="X Close"
            android:backgroundTint="#00000000"
            android:textColor="#888888"
            android:layout_marginTop="10dp" />

    </LinearLayout>

</FrameLayout>